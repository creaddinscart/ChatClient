<Window x:Class="ChatClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChatClient" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="22,0">
            <TextBlock Text="CC" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="  ChatClient" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResourceButton" Content="Redeem Resource" Click="Resource_Click"/>
                <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"/>
                <Button x:Name="AboutButton" Content="About" Click="About_Click"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,20">
            <Grid x:Name="WelcomePanel" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="WelcomeTitle" Text="Welcome to CC" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="WelcomeQuestion" Text="What should we call you?" FontSize="18" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Width="360" Height="42" FontSize="17" Margin="0,28,0,14" Padding="10"/>
                    <Button x:Name="EnterButton" Content="Enter ChatClient" Width="220" Height="44" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Click="Enter_Click"/>
                    <TextBlock Text="支持 IPv4、IPv6、局域网和虚拟网络" HorizontalAlignment="Center" Margin="0,25" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="HomePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,20,28,0">
                    <TextBlock x:Name="ConnectionTitle" Text="Connection Center" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="GreetingText" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,25"/>
                    <Button x:Name="CreateButton" Content="Create Server" Height="55" Click="CreateServer_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                    <Button x:Name="JoinButton" Content="Join Chat" Height="55" Click="JoinChat_Click"/>
                    <Button x:Name="VirtualRoomButton" Content="Virtual Network Room" Height="55" Click="VirtualRoom_Click"/>
                    <Button x:Name="WireGuardButton" Content="Real Virtual LAN" Height="55" Click="WireGuard_Click"/>
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="4,24,4,0"><StackPanel>
                        <TextBlock Text="网络状态" FontWeight="Bold"/>
                        <TextBlock x:Name="NetworkStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel></Border>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="28" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ReadyTitle" Text="Ready to start" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="创建服务器后，将获得服务器地址、端口和 64 位密钥。另一台设备或同一台电脑的第二个客户端可使用这些信息加入。" TextWrapping="Wrap" Margin="0,12,0,25" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="安全提示" FontWeight="Bold"/>
                        <TextBlock Text="公网 IPv4 通常需要路由器端口转发；虚拟网络房间通过公网中继和房间码连接，不需要安装虚拟网卡。" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="ChatPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="LeaveButton" Content="Leave Room" DockPanel.Dock="Right" Click="LeaveRoom_Click"/>
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ChatTitle" Text="Chat Room" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="ConnectionInfo" Margin="18,8" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                </DockPanel>
                <ListBox x:Name="MessagesList" Grid.Row="1" Margin="0,18" Background="{DynamicResource PanelBrush}" BorderThickness="0" Padding="14"/>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="TypingStatusText" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,4"/>
                    <DockPanel>
                        <Button Content="文件/照片/GIF" Width="125" Height="42" Click="Attach_Click"/>
                        <TextBox x:Name="MessageBox" Height="42" Padding="10" KeyDown="MessageBox_KeyDown" TextChanged="MessageBox_TextChanged"/>
                        <Button x:Name="SendButton" Content="Send" Width="90" Height="42" Click="Send_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
