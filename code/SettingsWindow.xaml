<Window x:Class="ChatClient.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="520" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Settings" FontSize="28" FontWeight="Bold"/>
        <TextBox x:Name="SearchBox" Grid.Row="1" Height="38" Margin="0,18,0,12" Padding="10" TextChanged="SearchBox_TextChanged"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="LanguageRow" Padding="12" Margin="0,4" Background="#12000000" CornerRadius="8"><DockPanel><TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center"/><Button x:Name="LanguageButton" Content="中文 / English" DockPanel.Dock="Right" Click="LanguageButton_Click"/></DockPanel></Border>
                <Border x:Name="ThemeRow" Padding="12" Margin="0,4" Background="#12000000" CornerRadius="8"><DockPanel><TextBlock x:Name="ThemeLabel" Text="Theme" VerticalAlignment="Center"/><Button x:Name="ThemeButton" Content="Dark / Light" DockPanel.Dock="Right" Click="ThemeButton_Click"/></DockPanel></Border>
                <Border x:Name="ColorRow" Padding="12" Margin="0,4" Background="#12000000" CornerRadius="8"><DockPanel><TextBlock x:Name="ColorLabel" Text="Chat color" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="ColorBox" Width="105" Height="30" Padding="6"/><Button x:Name="ColorButton" Content="Apply" Click="ColorButton_Click"/></StackPanel></DockPanel></Border>
                <Border x:Name="EncryptionRow" Padding="12" Margin="0,4" Background="#12000000" CornerRadius="8"><DockPanel><TextBlock x:Name="EncryptionLabel" Text="Message encryption" VerticalAlignment="Center"/><CheckBox x:Name="EncryptionBox" Content="Enabled" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Border>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="4,14" Foreground="#B42318"/>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="CloseButton" Grid.Row="3" Content="Close" Width="100" HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </Grid>
</Window>
